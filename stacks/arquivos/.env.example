# Formato: usuario:hash_da_senha:e:uid:gid
# Gere o hash com: openssl passwd -6
# Mantenha as aspas simples: o hash contém "$" e não pode ser interpolado.
SFTP_USERS='mundial:$6$troque$pelo_hash_gerado:e:1001:1001'
SFTP_PORT=2222
SFTP_PUBLISH_ADDRESS=0.0.0.0
SFTP_HOST_KEYS_DIR=/var/lib/mundial/sftp/host-keys
TZ=America/Sao_Paulo
